id: "wifi-sapi"
label: "RS911x Driver"
package: "Wi-Fi"
description: >
  Wi-Fi driver for RS911x devices

category: "Wi-Fi|RS911x"
quality: "alpha"
root_path: "platform/radio/wifi/rs9116/sapi"
provides:
  - name: "sapi"
requires:
  - name: "sapi_bus"
  - name: "sapi_host"
source:
  - path: "common/rsi_common_apis.c"
  - path: "common/rsi_device_init_apis.c"
  - path: "common/rsi_apis_non_rom.c"
  - path: "common/rsi_apis_rom.c"
  - path: "driver/rsi_common.c"
  - path: "driver/rsi_device_init.c"
  - path: "driver/rsi_driver.c"
  - path: "driver/rsi_driver_event_handlers.c"
  - path: "driver/rsi_events.c"
  - path: "driver/rsi_iap.c"
  - path: "driver/rsi_nwk.c"
  - path: "driver/rsi_pkt_mgmt.c"
  - path: "driver/rsi_queue.c"
  - path: "driver/rsi_scheduler.c"
  - path: "driver/rsi_setregion_countryinfo.c"
  - path: "driver/rsi_timer.c"
  - path: "driver/rsi_utils.c"
  - path: "driver/rsi_events_rom.c"
  - path: "driver/rsi_nwk_rom.c"
  - path: "driver/rsi_pkt_mgmt_rom.c"
  - path: "driver/rsi_queue_rom.c"
  - path: "driver/rsi_scheduler_rom.c"
  - path: "driver/rsi_utils_rom.c"
  - path: "driver/rsi_wlan.c"
  - path: "driver/rsi_bt_ble.c"
  - path: "wlan/rsi_wlan_apis.c"
  - path: "network/socket/rsi_socket.c"
  - path: "network/socket/rsi_socket_rom.c"
  - path: "network/protocols/rsi_dns.c"
  - path: "network/protocols/rsi_multicast.c"
  - path: "network/protocols/rsi_emb_mqtt_client.c"
  - path: "network/protocols/rsi_mqtt_client.c"
  - path: "network/protocols/rsi_mdnsd.c"
    condition: ["mqtt-client"]
  - path: "network/protocols/rsi_raw_data.c"
  - path: "network/protocols/rsi_web_socket.c"
  - path: "network/protocols/rsi_http_client.c"
  - path: "network/protocols/http_server/rsi_http_server.c"
  - path: "bluetooth/rsi_ble_gap_apis.c"
  - path: "bluetooth/rsi_ble_gatt_apis.c"
  - path: "bluetooth/rsi_bt_a2dp_apis.c"
  - path: "bluetooth/rsi_bt_avrcp_apis.c"
  - path: "bluetooth/rsi_bt_common_apis.c"
  - path: "bluetooth/rsi_bt_gap_apis.c"
  - path: "bluetooth/rsi_bt_spp_apis.c"
  - path: "bluetooth/rsi_bt_sbc_codec.c"
    condition: ["sbc-audio-codec"]
  - path: "network/protocols/rsi_http_ota_fw_up.c"
  - path: "rtos/freertos_wrapper/rsi_os_wrapper.c"
  - path: "ant/rsi_ant_apis.c"
  - path: "driver/rsi_ant.c"
  - path: "network/protocols/rsi_sntp_client.c"
  - path: "network/protocols/rsi_ftp.c"
    condition: ["freertos"]
include:
  - path: "include"
    file_list:
      - path: "rsi_ant.h"
      - path: "rsi_prop_protocol.h"
      - path: "rsi_apis_rom.h"
      - path: "rsi_bt_common_apis.h"
      - path: "rsi_driver.h"
      - path: "rsi_nwk.h"
      - path: "rsi_setregion_countryinfo.h"
      - path: "rsi_ble.h"
      - path: "rsi_bt_common_config.h"
      - path: "rsi_error.h"
      - path: "rsi_os.h"
      - path: "rsi_socket.h"
      - path: "rsi_wlan.h"
      - path: "rsi_ble_apis.h"
      - path: "rsi_bt_sbc_codec.h"
      - path: "rsi_events.h"
      - path: "rsi_pkt_mgmt.h"
      - path: "rsi_spi_cmd.h"
      - path: "rsi_wlan_apis.h"
      - path: "rsi_ble_common_config.h"
      - path: "rsi_bt_sdp.h"
      - path: "rsi_hal.h"
      - path: "rsi_spi_intf.h"
      - path: "rsi_wlan_common_config.h"
      - path: "rsi_bootup_config.h"
      - path: "rsi_common.h"
      - path: "rsi_hid.h"
      - path: "rsi_qspi_defines.h"
      - path: "rsi_timer.h"
      - path: "rsi_wlan_defines.h"
      - path: "rsi_bt.h"
      - path: "rsi_common_apis.h"
      - path: "rsi_queue.h"
      - path: "rsi_uart.h"
      - path: "rsi_wlan_non_rom.h"
      - path: "rsi_bt_apis.h"
      - path: "rsi_crypto.h"
      - path: "rsi_mac_api.h"
      - path: "rsi_scheduler.h"
      - path: "rsi_user.h"
      - path: "rsi_bt_common.h"
      - path: "rsi_data_types.h"
      - path: "rsi_mac_interface.h"
      - path: "rsi_sdio.h"
      - path: "rsi_utils.h"
  - path: "network/protocols"
    file_list:
      - path: "rsi_multicast.h"
      - path: "rsi_emb_mqtt_client.h"
      - path: "rsi_mqtt_client.h"
      - path: "rsi_web_socket.h"
      - path: "rsi_http_client.h"
      - path: "rsi_sntp_client.h"
      - path: "http_server/rsi_json_handlers.h"
      - path: "rsi_mdnsd.h"
define:
  - name: RSI_SAMPLE_HAL
  - name: RSI_WITH_OS
  - name: HAL_CONFIG
  - name: USE_HAL_DRIVER
