# Silicon Labs Project Configuration Tools: slcp, v0, Component selection file.
project_name: aws_test_agent
label: aws_test_agent
quality: alpha
description: Interactive command line demonstration
category: Example|Demo
package: wi-fi

include:

- path: '../common'
  file_list:
  - path: app.h
  - path: utilities.h

- path: '../common/config'
  file_list:
  - path: rsi_common_config.h
  - path: rsi_ble_config.h
  - path: rsi_wlan_config.h

- path: '../common/data'
  file_list:
  - path: pcm_data_buff.h

- path: '../common/commands/ble_gatt'
  file_list:
  - path: rsi_ble_gatt_device_info.h
  - path: rsi_gatt_common_config.h
  - path: rsi_ble_gatt_config.h

source:
- path: ../common/main.c
- path: ../common/app.c
- path: ../common/utilities.c

- path: ../common/commands/ble_commands.c
- path: ../common/commands/bt_commands.c
- path: ../common/commands/wlan_api_commands.c
- path: ../common/commands/wlan_socket_commands.c
- path: ../common/commands/rs911x_commands.c
- path: ../common/commands/aws_iot_sdk_commands.c


configuration:
- name: SL_BOARD_ENABLE_VCOM
  value: '1'
- name: SL_CLI_MAX_INPUT_ARGUMENTS
  value: '15'
- name: SL_CLI_INPUT_BUFFER_SIZE
  value: '(256)'
define:
- name: RSI_PROP_PROTOCOL_ENABLE
  value: '1'
- name: RSI_WLAN_ENABLE
- name: RSI_BLE_ENABLE
- name: RSI_BT_ENABLE
- name: RSI_ANT_ENABLE
- name: CONCURRENT_MODE
  value: 0
- name: RSI_MODE_11N_ENABLE
  value: 0
- name: RSI_HAND_SHAKE_TYPE
  value: 2
- name: RSI_SELECT_LP_OR_ULP_MODE
  value: 1
component:
- {id: sl_system}
- {id: iostream_retarget_stdio}
- instance: [cli]
  id: cli
- instance: [vcom]
  id: iostream_usart
# - {id: EFM32GG11B820F2048GL192}
- {id: wifi-sapi}
- {id: brd4180b}
- {id: EFR32MG21A020F1024IM32}
- {id: device_init_hfxo}
- {id: freertos}
- {id: device_init}
- {id: sleeptimer}
- {id: nvm3_default}
- {id: aws-sdk}
- {id: mqtt-client}
- {id: sbc-audio-codec}
other_file:
- path: readme.md
toolchain_settings: []
ui_hints:
  highlight:
  - {path: readme.md, focus: true}
template_contribution:
- name: cli_command
  priority: 0
  value:
    name: efr_reset
    handler: rsi_efr_reset_command
    help: Reset the EFR device
- name: cli_command
  priority: 0
  value:
    name: ram_dump
    handler: ram_dump_command
    help: Dump the RAM from the RS911x device
    argument:
    - {type: uint32, help: 'start_address'}
    - {type: uint32, help: 'end_address'}
- name: cli_command
  priority: 0
  value:
    name: set_features
    handler: rsi_set_features
    help: Set the feature bitmaps for the RS911x device
    argument:
    - {type: uint32, help: 'feature_bit_map'}
    - {type: uint32, help: 'tcp_ip_feature_bit_map'}
    - {type: uint32, help: 'custom_feature_bit_map'}
    - {type: uint32, help: 'ext_custom_feature_bit_map'}
    - {type: uint32, help: 'bt_feature_bit_map'}
    - {type: uint32, help: 'ext_tcp_ip_feature_bit_map'}
    - {type: uint32, help: 'ble_feature_bit_map'}
    - {type: uint32, help: 'ble_custom_ext_feature_bit_map'}
    - {type: uint32, help: 'rsi_config_feature_bit_map'}
    - {type: uint8, help: 'band'}
- name: cli_command
  priority: 0
  value: 
    name: aws_client_init
    handler: aws_client_init
    help: connect to aws iot endpoint
    argument:
    - {type: string, help: 'server_name'}
    - {type: uint16, help: 'server_port'}
    - {type: string, help: 'client_id'}
    - {type: uint8, help: 'clean session'}

- name: cli_command
  priority: 0
  value: 
    name: aws_client_disconnect
    handler: aws_client_disconnect
    help: disconnect from aws iot endpoint
- name: cli_command
  priority: 0
  value: 
    name: aws_client_subscribe
    handler: aws_client_subscribe
    help: subscribe to topic
    argument:
    - {type: string, help: 'topic'}
    - {type: uint16, help: 'qos'}
- name: cli_command
  priority: 0
  value: 
    name: aws_client_unsubscribe
    handler: aws_client_unsubscribe
    help: unsubscribe to topic
    argument:
    - {type: string, help: 'topic'}
- name: cli_command
  priority: 0
  value: 
    name: aws_client_publish
    handler: aws_client_publish
    help: publish message
    argument:
    - {type: string, help: 'topic'}
    - {type: string, help: 'payload'}
    - {type: uint8, help: 'payload is base64'}
    - {type: uint16, help: 'qos'}
- name: cli_command
  priority: 0
  value: 
    name: aws_shadow_init
    handler: aws_shadow_init_command
    help: shadow init
    argument:
    - {type: string, help: 'server_name'}
    - {type: uint16, help: 'server_port'}
    - {type: string, help: 'client_id'}
    - {type: string, help: 'thing_name'}
- name: cli_command
  priority: 0
  value: 
    name: aws_shadow_update
    handler: aws_shadow_update
    help: shadow update
    argument:
    - {type: uint16, help: 'temperature'}
- name: cli_command
  priority: 0
  value:
    name: init
    handler: rsi_device_init_command
    help: Initialize the RS911x device
    argument:
    - {type: uint16, help: 'oper_mode'}
    - {type: uint16, help: 'coex_mode'}
- name: cli_command
  priority: 0
  value:
    name: set_band
    handler: rsi_set_band_command
    help: Set Band
    argument:
    - {type: uint8, help: 'band' }
- name: cli_command
  priority: 0
  value:
    name: set_mac_address
    handler: rsa_wlan_set_mac_address
    help: Set MAC address
    argument:
    - {type: string, help: 'MAC Address String e.g. 12:34:56:78:90:af' }
- name: cli_command
  priority: 0
  value:
    name: get_mac_address
    handler: rsa_wlan_get_mac_address
    help: Get MAC address
    
- name: cli_command
  priority: 0
  value:
    name: get_wlan_stats
    handler: rsi_get_wlan_stats
    help: Get wlan status
    
- name: cli_command
  priority: 0
  value:
    name: get_network_params
    handler: rsi_get_network_params
    help: Get network params

- name: cli_command
  priority: 0
  value:
    name: get_wireless_info
    handler: rsi_get_wireless_info
    help: Get Wireless info
- name: cli_command
  priority: 0
  value:
    name: begin_set_ssl_certificate
    handler: begin_set_ssl_certificate
    help: Start SSL certificate transfer
    argument:
    - {type: uint16, help: 'length'}
- name: cli_command
  priority: 0
  value:
    name: set_ssl_certificate_part
    handler: set_ssl_certificate_part
    help: SSL certificate transfer chunk
    argument:
    - {type: uint16, help: 'offset'}
    - {type: string, help: 'contents'}
- name: cli_command
  priority: 0
  value:
    name: end_set_ssl_certificate
    handler: end_set_ssl_certificate
    help: Finalize SSL certificate transfer
    argument:
    - {type: uint8, help: 'cert type'}
    - {type: uint8, help: 'index'}


- name: cli_command
  priority: 0
  value:
    name: reset
    handler: rsi_device_reset_command
    help: Reset the RS911x device
- name: cli_command
  priority: 0
  value:
    name: version
    handler: rsi_device_version_command
    help: Get RS911x device firmware version
- name: cli_command
  priority: 0
  value:
    name: wlan_scan
    handler: rsi_wlan_scan_command
    help: Scan for a Wi-Fi AP
    argument:
    - {type: string, help: SSID}
    - {type: uint32, help: Channel}
- name: cli_command
  priority: 0
  value:
    name: wlan_scan_async
    handler: rsi_wlan_scan_async_command
    help: Scan for a Wi-Fi AP asynchronously
    argument:
    - {type: string, help: SSID}
    - {type: uint32, help: Channel}
- name: cli_command
  priority: 0
  value:
    name: wlan_connect
    handler: rsi_wlan_connect_command
    help: Connect to AP
    argument:
    - {type: string, help: SSID}
    - {type: uint8, help: Security}
    - {type: string, help: Passphrase}
    - {type: uint8, help: power level}
    - {type: uint8, help: join feature bitmap}
    - {type: uint32, help: listen interval}
    - {type: uint8, help: data rate}

- name: cli_command
  priority: 0
  value:
    name: wlan_power_save
    handler: rsi_device_power_save
    help: Set power save mode
    argument:
      - {type: uint8, help: psp mode}
      - {type: uint8, help: psp type}

- name: cli_command
  priority: 0
  value:
    name: config_ipaddress
    handler: rsi_config_ipaddress_command
    help: Configure the client IP
    argument:
    - {type: string, help: '[dhcp, static]'}
    - {type: string, help: ip}
    - {type: string, help: gateway}
    - {type: string, help: subnetmask}
    - {type: uint8, help: vap_id}

- name: cli_command
  priority: 0
  value:
    name: set_rejoin
    handler: rsi_set_rejoin_command
    help: set rejoin
    argument:
    - {type: uint32, help: rejoin max retry}
    - {type: uint32, help: rejoin scan interval}
    - {type: uint32, help: rejoin beacon missed count}
    - {type: uint32, help: rejoin first time retry}

    
- name: cli_command
  priority: 0
  value:
    name: set_bgscan_params
    handler: rsi_set_bgscan_params
    help: sets the rtc timer
    argument:
    - {type: uint16, help: enable bgscan}
    - {type: uint16, help: enable instance bgscan}
    - {type: uint16, help: bgscan threshold}
    - {type: uint16, help: bgscan tolerance threshold}
    - {type: uint16, help: bgscan periodicity}
    - {type: uint16, help: active scan duration}
    - {type: uint16, help: passive scan duration}
    - {type: uint8, help: multiprobe}

- name: cli_command
  priority: 0
  value:
    name: set_default_bgscan_params
    handler: rsi_set_default_bgscan_params
    help: set default bg scan parameters 
    
- name: cli_command
  priority: 0
  value:
    name: set_roam_params
    handler: rsi_set_roaming_params
    help: set roam parameters 
    argument:
    - {type: uint32, help: roam threshold}
    - {type: uint32, help: roam hysterisis}
 
- name: cli_command
  priority: 0
  value:
    name: set_default_roam_params
    handler: rsi_set_default_roaming_params
    help: set default roaming parameters 



- name: cli_command
  priority: 0
  value:
    name: clear_cert
    handler: rsi_clear_cert
    help: clear the certificate
    argument:
    - {type: uint8, help: 'cert type'}
    - {type: uint8, help: 'index'}
    


- name: cli_command
  priority: 0
  value:
    name: radio_init
    handler: wlan_radio_init_command
    help: initilized radio
    

- name: cli_command
  priority: 0
  value:
    name: dns_get
    handler: rsi_dns_enable
    help: resolve the ip address for url
    argument:
      - {type: uint8, help: ip_version}
      - {type: string, help: domain name}
      - {type: string, help: primary dns address}
      - {type: string, help: secondary dns address}
      

   
- name: cli_command
  priority: 0
  value:
    name: set_power_save_params
    handler: rsi_set_power_save_params
    help: set the power save parameters
    argument:
    - {type: uint8, help: dtim aligned type}
    - {type: uint16, help: monitor interval}
    - {type: uint8, help: number of dtim skip}

- name: cli_command
  priority: 0
  value:
    name: sntp_create
    handler: rsi_sntp_create
    help: Send request to sntp server 
    argument:
    - {type: uint8, help: flags}
    - {type: string, help: sntp server ip}
    - {type: uint8, help: sntp method}
    - {type: uint16, help: sntp timeout}

- name: cli_command
  priority: 0
  value:
    name: get_sntp_time
    handler: rsi_get_sntp_time
    help: Get sntp time

- name: cli_command
  priority: 0
  value:
    name: get_sntp_timedate
    handler: rsi_get_sntp_timedate
    help: Get sntp time date
    
- name: cli_command
  priority: 0
  value:
    name: get_sntp_server_info
    handler: rsi_get_sntp_server_info
    help: Get sntp server info
    
- name: cli_command
  priority: 0
  value:
    name: sntp_delete
    handler: rsi_sntp_delete
    help: delete sntp intiation 
    


- name: cli_command
  priority: 0
  value:
    name: wlan_power_save_listen_interval
    handler: rsi_device_power_save_listen_interval
    help: Set power save mode
    argument:
    - {type: uint8, help: psp mode}
    - {type: uint8, help: psp type}
    - {type: uint16, help: listen_interval}


- name: cli_command
  priority: 0
  value:
    name: wireless_deinit
    handler: wireless_deinit_command
    help: deinit wireless

- name: cli_command
  priority: 0
  value:
    name: wireless_device_init
    handler: wireless_device_init_command
    help: initilize device
    argument:
    - {type: uint16, help: opermode}
    - {type: uint16, help: coex}

- name: cli_command
  priority: 0
  value:
    name:  bt_power_save_profile
    handler: rsi_bt_power_save_profile_command
    help: 'Selects the power save profile mode for BT / BLE'
    argument:
    - {type: uint8, help: 'mode : 0 - RSI_ACTIVE, 1 – RSI_SLEEP_MODE_1, 2 - RSI_SLEEP_MODE_2, 8 - RSI_SLEEP_MODE_8'}
    - {type: uint8, help: psp type}

- name: cli_command
  priority: 0
  value:
    name: set_feature_frame_settings
    handler: rsi_set_feature_frame_settings
    help: Set the feature bitmaps for rsi_send_feature_frame() API
    argument:
    - {type: uint8, help: 'pll mode'}
    - {type: uint8, help: 'rf type'}
    - {type: uint8, help: 'wireless mode'}
    - {type: uint8, help: 'enable ppp'}
    - {type: uint8, help: 'afe type'}
    - {type: uint32, help: 'feature enables'}

- name: cli_command
  priority: 0
  value:
    name: set_region
    handler: rsi_set_region_command
    help: set the region
    argument:
    - {type: uint8, help: region}
    - {type: uint8, help: region code}
    - {type: uint16, help: module type}

- name: cli_command
  priority: 0
  value:
    name: set_socket_limit
    handler: rsi_set_socket_limit
    help: sets socket limit
    argument:
    - {type: uint8, help: server socket limit}
    - {type: uint8, help: client socket limit}

- name: cli_command
  priority: 0
  value: {name: wlan_disconnect, handler: rsi_wlan_disconnect_command, help: Disconnect
      from AP}

- name: cli_command
  priority: 0
  value:
    name: cfg_get
    handler: rsi_cfg_get_command
    help: Get store configuration profile info

- name: cli_command
  priority: 0
  value:
    name: filter_broadcast
    handler: rsi_wlan_filter_broadcast_command
    help: program broadcast packet threshold
    argument:
    - {type: uint16, help: beacon_drop}
    - {type: uint8, help: bcast_in_tim}
    - {type: uint8, help: bcast_in_tim_next_cmd}

- name: cli_command
  priority: 0
  value:
    name: wireless_antenna
    handler: rsi_wireless_antenna_command
    help: select the antenna
    argument:
    - {type: uint8, help: type}
    - {type: uint8, help: gain_2g}
    - {type: uint8, help: gain_5g}

- name: cli_command
  priority: 0
  value:
    name: bt_per_tx
    handler: rsi_bt_per_tx_command
    help: configure the per transmit parameters
    argument:
    - {type: uint8, help: cmd_id}
    - {type: uint8, help: transmit_enable}
    - {type: string, help: device_Addr}
    - {type: string, help: pkt_len}
    - {type: uint8, help: pkt_type}
    - {type: uint8, help: br_edr_mode}
    - {type: uint8, help: rx_chnl_in}
    - {type: uint8, help: tx_chnl_in}
    - {type: uint8, help: link_type}
    - {type: uint8, help: scrambler_seed}
    - {type: uint8, help: hopping_type}
    - {type: uint8, help: ant_sel}
    - {type: uint8, help: pll_mode}
    - {type: uint8, help: rf_type}
    - {type: uint8, help: rf_chain}
    - {type: uint8, help: payload_type}
    - {type: uint8, help: tx_power}
    - {type: uint8, help: transmit_mode}
    - {type: uint8, help: inter_pkt_gap}
    - {type: string, help: num_packets}

- name: cli_command
  priority: 0
  value:
    name: bt_per_rx
    handler: rsi_bt_per_rx_command
    help: configure the per receive parameters
    argument:
    - {type: uint8, help: cmd_id}
    - {type: uint8, help: receive_enable}
    - {type: string, help: device_Addr}
    - {type: string, help: pkt_len}
    - {type: uint8, help: pkt_type}
    - {type: uint8, help: br_edr_mode}
    - {type: uint8, help: rx_chnl_in}
    - {type: uint8, help: tx_chnl_in}
    - {type: uint8, help: link_type}
    - {type: uint8, help: scrambler_seed}
    - {type: uint8, help: hopping_type}
    - {type: uint8, help: ant_sel}
    - {type: uint8, help: pll_mode}
    - {type: uint8, help: rf_type}
    - {type: uint8, help: rf_chain}
    - {type: uint8, help: loop_back_mode}

- name: cli_command
  priority: 0
  value:
    name: bt_per_stats
    handler: rsi_bt_per_stats_command
    help: request the local device for bt per operation
    argument:
    - {type: uint8, help: cmd_type}
    - {type: uint16, help: crc_fail_cnt}
    - {type: uint16, help: crc_pass_cnt}
    - {type: uint16, help: tx_abort_cnt}
    - {type: uint16, help: rx_drop_cnt}
    - {type: uint16, help: rx_cca_idle_cnt}
    - {type: uint16, help: rx_start_idle_cnt}
    - {type: uint16, help: rx_abrt_cnt}
    - {type: uint16, help: tx_dones}
    - {type: int8, help: rssi}
    - {type: int8, help: id_pkts_rcvd}

- name: cli_command
  priority: 0
  value:
    name: set_config_enable
    handler: rsi_set_auto_config
    help: sets the auto configuration
    argument:
    - {type: uint8, help: config_enable parameter}
    - {type: uint32, help: profile_type parameter}

- name: cli_command
  priority: 0
  value:
    name: set_config_save
    handler: rsi_set_config_save
    help: saves the configuration

- name: cli_command
  priority: 0
  value:
    name: shutdown
    handler: rsi_shutdown_command
    help: closes the socket on demand
    argument:
    - {type: int32, help: socket ID}

- name: cli_command
  priority: 0
  value:
    name: wlan_radio_init
    handler: rsi_wlan_radio_init_command
    help: wifi radio init

- name: cli_command
  priority: 0
  value:
    name: wlan_radio_deinit
    handler: rsi_wlan_radio_deinit_command
    help: wifi radio deinit