# Silicon Labs Project Configuration Tools: slcp, v0, Component selection file.
project_name: concurrent_test_agent
label: concurrent_test_agent
quality: alpha
description: Interactive command line demonstration
category: Example|Demo
package: wi-fi

include:

- path: '../common'
  file_list:
  - path: app.h
  - path: utilities.h

- path: '../common/config'
  file_list:
  - path: rsi_common_config.h
  - path: rsi_ble_config.h
  - path: rsi_wlan_config.h

- path: '../common/data'
  file_list:
  - path: pcm_data_buff.h

- path: '../common/commands/ble_gatt'
  file_list:
  - path: rsi_ble_gatt_device_info.h
  - path: rsi_gatt_common_config.h
  - path: rsi_ble_gatt_config.h

source:
- path: ../common/main.c
- path: ../common/app.c
- path: ../common/utilities.c

- path: ../common/commands/ble_commands.c
- path: ../common/commands/bt_commands.c
- path: ../common/commands/wlan_api_commands.c
- path: ../common/commands/wlan_socket_commands.c
- path: ../common/commands/rs911x_commands.c
- path: ../common/commands/iperf_command.c
- path: ../common/commands/mqtt_commands.c
- path: ../common/commands/http_commands.c
- path: ../common/commands/aws_iot_sdk_commands.c
- path: ../common/commands/ant_commands.c
- path: ../common/commands/wlan_wireless_firmware_upgrade.c
  
  # ble_gatt
- path: ../common/commands/ble_gatt/rsi_ble_gatt_device_info.c
- path: ../common/commands/ble_gatt/rsi_ble_gatt_main_task.c
- path: ../common/commands/ble_gatt/rsi_ble_gatt_subtasks.c
- path: ../common/commands/ble_gatt/gatt_commands.c

configuration:
- name: SL_BOARD_ENABLE_VCOM
  value: '1'
- name: SL_CLI_MAX_INPUT_ARGUMENTS
  value: '15'
- name: SL_CLI_INPUT_BUFFER_SIZE
  value: '(256)'
define:
- name: RSI_PROP_PROTOCOL_ENABLE
  value: '1'
- name: RSI_WLAN_ENABLE
- name: RSI_BLE_ENABLE
- name: RSI_BT_ENABLE
- name: RSI_ANT_ENABLE
- name: CONCURRENT_MODE
  value: '1'


component:
- {id: sl_system}
- {id: iostream_retarget_stdio}
- instance: [cli]
  id: cli
- instance: [vcom]
  id: iostream_usart
# - {id: EFM32GG11B820F2048GL192}
- {id: wifi-sapi}
- {id: brd4180b}
- {id: EFR32MG21A020F1024IM32}
- {id: device_init_hfxo}
- {id: freertos}
- {id: device_init}
- {id: sleeptimer}
- {id: nvm3_default}
- {id: aws-sdk}
- {id: mqtt-client}
- {id: sbc-audio-codec}

other_file:
- path: readme.md

toolchain_settings: []

ui_hints:
  highlight:
  - {path: readme.md, focus: true}

template_contribution:
- name: cli_command
  priority: 0
  value:
    name: efr_reset
    handler: rsi_efr_reset_command
    help: Reset the EFR device
- name: cli_command
  priority: 0
  value:
    name: ram_dump
    handler: ram_dump_command
    help: Dump the RAM from the RS911x device
    argument:
    - {type: uint32, help: 'start_address'}
    - {type: uint32, help: 'end_address'}
- name: cli_command
  priority: 0
  value:
    name: set_features
    handler: rsi_set_features
    help: Set the feature bitmaps for the RS911x device
    argument:
    - {type: uint32, help: 'feature_bit_map'}
    - {type: uint32, help: 'tcp_ip_feature_bit_map'}
    - {type: uint32, help: 'custom_feature_bit_map'}
    - {type: uint32, help: 'ext_custom_feature_bit_map'}
    - {type: uint32, help: 'bt_feature_bit_map'}
    - {type: uint32, help: 'ext_tcp_ip_feature_bit_map'}
    - {type: uint32, help: 'ble_feature_bit_map'}
    - {type: uint32, help: 'ble_custom_ext_feature_bit_map'}
    - {type: uint32, help: 'rsi_config_feature_bit_map'}
    - {type: uint8, help: 'band'}
- name: cli_command
  priority: 0
  value: 
    name: aws_client_init
    handler: aws_client_init
    help: connect to aws iot endpoint
    argument:
    - {type: string, help: 'server_name'}
    - {type: uint16, help: 'server_port'}
    - {type: string, help: 'client_id'}
- name: cli_command
  priority: 0
  value: 
    name: aws_client_disconnect
    handler: aws_client_disconnect
    help: disconnect from aws iot endpoint
- name: cli_command
  priority: 0
  value: 
    name: aws_client_subscribe
    handler: aws_client_subscribe
    help: subscribe to topic
    argument:
    - {type: string, help: 'topic'}
    - {type: uint16, help: 'qos'}
- name: cli_command
  priority: 0
  value: 
    name: aws_client_unsubscribe
    handler: aws_client_unsubscribe
    help: unsubscribe to topic
    argument:
    - {type: string, help: 'topic'}
- name: cli_command
  priority: 0
  value: 
    name: aws_client_publish
    handler: aws_client_publish
    help: publish message
    argument:
    - {type: string, help: 'topic'}
    - {type: string, help: 'payload'}
    - {type: uint8, help: 'payload is base64'}
    - {type: uint16, help: 'qos'}
- name: cli_command
  priority: 0
  value: 
    name: aws_shadow_init
    handler: aws_shadow_init_command
    help: shadow init
    argument:
    - {type: string, help: 'server_name'}
    - {type: uint16, help: 'server_port'}
    - {type: string, help: 'client_id'}
    - {type: string, help: 'thing_name'}
- name: cli_command
  priority: 0
  value: 
    name: aws_shadow_update
    handler: aws_shadow_update
    help: shadow update
    argument:
    - {type: uint16, help: 'temperature'}
- name: cli_command
  priority: 0
  value:
    name: init
    handler: rsi_device_init_command
    help: Initialize the RS911x device
    argument:
    - {type: uint16, help: 'oper_mode'}
    - {type: uint16, help: 'coex_mode'}
- name: cli_command
  priority: 0
  value:
    name: set_band
    handler: rsi_set_band_command
    help: Set Band
    argument:
    - {type: uint8, help: 'band' }
- name: cli_command
  priority: 0
  value:
    name: set_mac_address
    handler: rsa_wlan_set_mac_address
    help: Set MAC address
    argument:
    - {type: string, help: 'MAC Address String e.g. 12:34:56:78:90:af' }
- name: cli_command
  priority: 0
  value:
    name: get_mac_address
    handler: rsa_wlan_get_mac_address
    help: Get MAC address
    
- name: cli_command
  priority: 0
  value:
    name: get_wlan_stats
    handler: rsi_get_wlan_stats
    help: Get wlan status
    
- name: cli_command
  priority: 0
  value:
    name: get_network_params
    handler: rsi_get_network_params
    help: Get network params

- name: cli_command
  priority: 0
  value:
    name: get_wireless_info
    handler: rsi_get_wireless_info
    help: Get Wireless info
- name: cli_command
  priority: 0
  value:
    name: begin_set_ssl_certificate
    handler: begin_set_ssl_certificate
    help: Start SSL certificate transfer
    argument:
    - {type: uint16, help: 'length'}
- name: cli_command
  priority: 0
  value:
    name: set_ssl_certificate_part
    handler: set_ssl_certificate_part
    help: SSL certificate transfer chunk
    argument:
    - {type: uint16, help: 'offset'}
    - {type: string, help: 'contents'}
- name: cli_command
  priority: 0
  value:
    name: end_set_ssl_certificate
    handler: end_set_ssl_certificate
    help: Finalize SSL certificate transfer
    argument:
    - {type: uint8, help: 'cert type'}
    - {type: uint8, help: 'index'}

- name: cli_command
  priority: 0
  value:
    name: iperf
    handler: start_iperf_command
    help: Start iperf
    argument:
    - {type: string, help: 'Destination IP' }
    - {type: uint16, help: 'Destination port'}
- name: cli_command
  priority: 0
  value:
    name: reset
    handler: rsi_device_reset_command
    help: Reset the RS911x device
- name: cli_command
  priority: 0
  value:
    name: version
    handler: rsi_device_version_command
    help: Get RS911x device firmware version
- name: cli_command
  priority: 0
  value:
    name: wlan_scan
    handler: rsi_wlan_scan_command
    help: Scan for a Wi-Fi AP
    argument:
    - {type: string, help: SSID}
    - {type: uint32, help: Channel}
- name: cli_command
  priority: 0
  value:
    name: wlan_scan_async
    handler: rsi_wlan_scan_async_command
    help: Scan for a Wi-Fi AP asynchronously
    argument:
    - {type: string, help: SSID}
    - {type: uint32, help: Channel}
- name: cli_command
  priority: 0
  value:
    name: wlan_connect
    handler: rsi_wlan_connect_command
    help: Connect to AP
    argument:
    - {type: string, help: SSID}
    - {type: uint8, help: Security}
    - {type: string, help: Passphrase}
    - {type: uint8, help: power level}
    - {type: uint8, help: join feature bitmap}
    - {type: uint32, help: listen interval}
    - {type: uint8, help: data rate}
- name: cli_command
  priority: 0
  value:
    name: wlan_connect_async
    handler: rsi_wlan_connect_async_command
    help: Connect to AP asynchronously
    argument:
    - {type: string, help: SSID}
    - {type: uint8, help: Security}
    - {type: string, help: Passphrase}
- name: cli_command
  priority: 0
  value:
    name: wlan_ap_start
    handler: rsi_wlan_ap_start_command
    help: Start soft AP
    argument:
    - {type: string, help: SSID}
    - {type: uint8, help: channel}
    - {type: uint8, help: security}
    - {type: uint8, help: encryption}
    - {type: string, help: passphrase}
    - {type: uint16, help: beacon}
    - {type: uint8, help: dtim}
- name: cli_command
  priority: 0
  value: {name: wlan_execute_post_connect_cmds, handler: rsi_wlan_execute_post_connect_cmds_command,
    help: To be called after rsi_wlan_connect_async}
- name: cli_command
  priority: 0
  value: {name: wlan_disconnect, handler: rsi_wlan_disconnect_command, help: Disconnect
      from AP}
- name: cli_command
  priority: 0
  value:
    name: wlan_disconnect_stations
    handler: rsi_wlan_disconnect_stations_command
    help: Disconnect a station from soft AP
    argument:
    - {type: hex, help: Client MAC}
- name: cli_command
  priority: 0
  value: {name: wlan_get_status, handler: rsi_wlan_get_status_command, help: Retrieve
      Wi-Fi status}
- name: cli_command
  priority: 0
  value:
    name: gpio_set_sleep
    handler: rsi_device_set_sleep
    help: Enable/disable sleep mode
    argument:
      - {type: uint8, help: Sleep mode - 1 to wake, 0 to sleep}
- name: cli_command
  priority: 0
  value:
    name: gpio_read_wake
    handler: rsi_device_read_wake
    help: Read wake indication
- name: cli_command
  priority: 0
  value:
    name: wlan_power_save
    handler: rsi_device_power_save
    help: Set power save mode
    argument:
      - {type: uint8, help: psp mode}
      - {type: uint8, help: psp type}
- name: cli_command
  priority: 0
  value: {name: wlan_wps_generate_pin, handler: rsi_wlan_wps_generate_pin_command,
    help: Generate a WPS PIN}
- name: cli_command
  priority: 0
  value:
    name: wlan_wps_enter_pin
    handler: rsi_wlan_wps_enter_pin_command
    help: Set the WPS PIN
    argument:
    - {type: string, help: PIN}
- name: cli_command
  priority: 0
  value:
    name: wlan_wps_push_button_event
    handler: rsi_wlan_wps_push_button_event_command
    help: Start WPS push button mode
    argument:
    - {type: string, help: SSID}
- name: cli_command
  priority: 0
  value:
    name: transmit_test_start
    handler: rsi_transmit_test_start_command
    help: Start TX test
    argument:
    - {type: uint16, help: power}
    - {type: uint32, help: rate}
    - {type: uint16, help: length}
    - {type: uint16, help: mode}
    - {type: uint16, help: channel}
- name: cli_command
  priority: 0
  value: {name: transmit_test_stop, handler: rsi_transmit_test_stop_command, help: Stop
      TX test}
- name: cli_command
  priority: 0
  value:
    name: wlan_receive_stats_start
    handler: rsi_wlan_receive_stats_start_command
    help: Start RX stats
    argument:
    - {type: uint16, help: channel}
- name: cli_command
  priority: 0
  value: {name: wlan_receive_stats_stop, handler: rsi_wlan_receive_stats_stop_command,
    help: Stop RX stats}
- name: cli_command
  priority: 0
  value:
    name: set_wlan_timeout
    handler: rsi_set_wlan_timeout
    help: set wlan timeout
    argument:
    - {type: uint32, help: bitmap}
    - {type: uint32, help: value}
- name: cli_command
  priority: 0
  value:
    name: set_config_enable
    handler: rsi_set_auto_config
    help: set config enable
    argument:
    - {type: uint8, help: enable}    
    - {type: uint32, help: profile type}    
- name: cli_command
  priority: 0
  value:
    name: set_config_save
    handler: rsi_set_config_save
    help: set config enable
- name: cli_command
  priority: 0
  value:
    name: wlan_get
    handler: rsi_wlan_get_command
    help: Get command
    argument:
    - {type: uint16, help: command}
- name: cli_command
  priority: 0
  value:
    name: wlan_set
    handler: rsi_wlan_set_command
    help: Set command
    argument:
    - {type: uint16, help: command}
- name: cli_command
  priority: 0
  value:
    name: wlan_wfd_start_discovery
    handler: rsi_wlan_wfd_start_discovery_command
    help: Start Wi-FI Direct discovery
    argument:
    - {type: uint16, help: GO intent}
    - {type: string, help: name}
    - {type: uint16, help: channel}
    - {type: string, help: ssid_post_fix}
    - {type: string, help: psk}
- name: cli_command
  priority: 0
  value:
    name: wlan_wfd_connect
    handler: rsi_wlan_wfd_connect_command
    help: Wi-Fi Direct connect
    argument:
    - {type: string, help: name}
- name: cli_command
  priority: 0
  value:
    name: wlan_enable_auto_config
    handler: rsi_wlan_enable_auto_config_command
    help: Enable auto-config
    argument:
    - {type: uint8, help: enable}
    - {type: uint32, help: type}
- name: cli_command
  priority: 0
  value:
    name: wlan_bgscan_profile
    handler: rsi_wlan_bgscan_profile_command
    help: bgscan
    argument:
    - {type: uint8, help: command}
- name: cli_command
  priority: 0
  value:
    name: wlan_scan_with_bitmap_options
    handler: rsi_wlan_scan_with_bitmap_options_command
    help: Scan with bitmap options
    argument:
    - {type: string, help: SSID}
    - {type: uint16, help: channel}
    - {type: uint32, help: bitmap}
- name: cli_command
  priority: 0
  value:
    name: wlan_scan_async_with_bitmap_options
    handler: rsi_wlan_scan_async_with_bitmap_options_command
    help: Async scan with bitmap options
    argument:
    - {type: string, help: SSID}
    - {type: uint16, help: channel}
    - {type: uint32, help: bitmap}
- name: cli_command
  priority: 0
  value:
    name: wlan_ping_async
    handler: rsi_wlan_ping_async_command
    help: Ping asynchronously
    argument:
    - {type: uint8, help: flags}
    - {type: string, help: IP address}
    - {type: uint16, help: packet size}
- name: cli_command
  priority: 0
  value:
    name: socket
    handler: rsi_socket_command
    help: Create a socket
    argument:
    - {type: uint32, help: family}
    - {type: uint32, help: type}
    - {type: uint32, help: protocol}
    - {type: uint8, help: flag to open socket as synchronous or asynchronous}
- name: cli_command
  priority: 0
  value:
    name: bind
    handler: rsi_bind_command
    help: Bind socket to port
    argument:
    - {type: uint32, help: socket}
    - {type: uint16, help: port}
    - {type: string, help: ip}
- name: cli_command
  priority: 0
  value:
    name: connect
    handler: rsi_connect_command
    help: Connect to a remote socket
    argument:
    - {type: uint32, help: socket}
    - {type: string, help: ip}
    - {type: uint16, help: port}
- name: cli_command
  priority: 0
  value:
    name: listen
    handler: rsi_listen_command
    help: Listen
    argument:
    - {type: uint32, help: socket}
    - {type: uint32, help: backlog}
- name: cli_command
  priority: 0
  value:
    name: accept
    handler: rsi_accept_command
    help: Accept
    argument:
    - {type: uint32, help: socket}
- name: cli_command
  priority: 0
  value:
    name: recvfrom
    handler: rsi_recvfrom_command
    help: Receive from
    argument:
    - {type: uint32, help: socket}
    - {type: uint32, help: data_len}
- name: cli_command
  priority: 0
  value:
    name: recv
    handler: rsi_recv_command
    help: ''
    argument:
    - {type: uint32, help: socket}
    - {type: uint32, help: data_len}
- name: cli_command
  priority: 0
  value:
    name: sendto
    handler: rsi_sendto_command
    help: ''
    argument:
    - {type: uint32, help: socketId}
    - {type: uint32, help: data_len}
    - {type: string, help: remote_ip}
    - {type: uint16, help: remote_port}
- name: cli_command
  priority: 0
  value:
    name: send
    handler: rsi_send_command
    help: ''
    argument:
    - {type: uint32, help: socketId}
    - {type: uint32, help: data_len}
- name: cli_command
  priority: 0
  value:
    name: send_large_data_async
    handler: rsi_send_large_data_async_command
    help: ''
    argument:
    - {type: uint32, help: ''}
- name: cli_command
  priority: 0
  value:
    name: select
    handler: rsi_select_command
    help: ''
    argument:
    - {type: uint32, help: ''}
- name: cli_command
  priority: 0
  value:
    name: shutdown
    handler: rsi_shutdown_command
    help: 'close socket'
    argument:
    - {type: uint32, help: 'socket_id'}
- name: cli_command
  priority: 0
  value:
    name: socket_async
    handler: rsi_socket_async_command
    help: ''
    argument:
    - {type: uint32, help: ''}
- name: cli_command
  priority: 0
  value:
    name: config_ipaddress
    handler: rsi_config_ipaddress_command
    help: Configure the client IP
    argument:
    - {type: string, help: '[dhcp, static]'}
    - {type: string, help: ip}
    - {type: string, help: gateway}
    - {type: string, help: subnetmask}
    - {type: uint8, help: vap_id}
- name: cli_command
  priority: 0
  value:
    name: check_state
    handler: rsi_check_state_command
    help: ''
    argument:
    - {type: uint32, help: ''}
- name: cli_command
  priority: 0
  value:
    name: get_application_socket_descriptor
    handler: rsi_get_application_socket_descriptor_command
    help: ''
    argument:
    - {type: uint32, help: ''}
- name: cli_command
  priority: 0
  value:
    name: clear_sockets
    handler: rsi_clear_sockets_command
    help: ''
    argument:
    - {type: uint32, help: ''}
- name: cli_command
  priority: 0
  value:
    name: calculate_buffers_required_command
    handler: calculate_buffers_required_command
    help: ''
    argument:
    - {type: uint32, help: ''}
- name: cli_command
  priority: 0
  value:
    name: calculate_length_to_send_command
    handler: calculate_length_to_send_command
    help: ''
    argument:
    - {type: uint32, help: ''}
- name: cli_command
  priority: 0
  value:
    name: send_async
    handler: rsi_send_async_command
    help: ''
    argument:
    - {type: uint32, help: ''}
- name: cli_command
  priority: 0
  value:
    name: sendto_async
    handler: rsi_sendto_async_command
    help: ''
    argument:
    - {type: uint32, help: ''}
- name: cli_command
  priority: 0
  value:
    name: setsockopt
    handler: rsi_setsockopt_command
    help: ''
    argument:
    - {type: uint32, help: ''}
- name: cli_command
  priority: 0
  value:
    name: get_app_socket_descriptor
    handler: rsi_get_app_socket_descriptor_command
    help: ''
    argument:
    - {type: uint32, help: ''}
- name: cli_command
  priority: 0
  value:
    name: get_primary_socket_id
    handler: rsi_get_primary_socket_id_command
    help: ''
    argument:
    - {type: uint32, help: ''}
- name: cli_command
  priority: 0
  value:
    name: fd_isset
    handler: rsi_fd_isset_command
    help: ''
    argument:
    - {type: uint32, help: ''}
- name: cli_command
  priority: 0
  value:
    name: set_fd
    handler: rsi_set_fd_command
    help: ''
    argument:
    - {type: uint32, help: ''}
- name: cli_command
  priority: 0
  value:
    name: fd_clr
    handler: rsi_fd_clr_command
    help: ''
    argument:
    - {type: uint32, help: ''}
- name: cli_command
  priority: 0
  value:
    name: sendto_iperf
    handler: rsi_sendto_iperf_command
    help: send to iperf server
    argument:
    - {type: uint32, help: protocol_family}
    - {type: uint32, help: type}
    - {type: uint32, help: protocol}
    - {type: uint16, help: local_port}
    - {type: string, help: local_ip}
    - {type: string, help: remote_ip}
    - {type: uint16, help: remote_port}
    - {type: uint32, help: data_len}
    - {type: uint16, help: ttl_sec}
    - {type: uint16, help: compute_throughput}
    - {type: uint16, help: debug_output}
    - {type: uint16, help: is_async}
- name: cli_command
  priority: 0
  value:
    name: recvfrom_iperf
    handler: rsi_recvfrom_iperf_command
    help: receive from iperf server
    argument:
    - {type: uint32, help: protocol_family}
    - {type: uint32, help: type}
