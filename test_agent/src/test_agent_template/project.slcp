# Silicon Labs Project Configuration Tools: slcp, v0, Component selection file.

# TODO: rename to match parent directory name
project_name: test_agent_template

# TODO: rename to match parent directory name
label: generic_test_agent

quality: alpha
description: wi-fi sqa test agent
category: Example|Demo
package: wi-fi

include:

- path: '../common'
  file_list:
  - path: app.h
  - path: utilities.h

- path: 'config'
  file_list:
  - path: rsi_wlan_config.h

source:
- path: ../common/main.c
- path: ../common/app.c
- path: ../common/utilities.c

configuration:
- name: SL_BOARD_ENABLE_VCOM
  value: '1'
- name: SL_CLI_MAX_INPUT_ARGUMENTS
  value: '15'
- name: SL_CLI_INPUT_BUFFER_SIZE
  value: '(256)'
define:
- name: RSI_WLAN_ENABLE


component:
- {id: sl_system}
- {id: iostream_retarget_stdio}
- instance: [cli]
  id: cli
- instance: [vcom]
  id: iostream_usart
- {id: wifi-sapi}
- {id: brd4180b}
- {id: EFR32MG21A020F1024IM32}
- {id: device_init_hfxo}
- {id: freertos}
- {id: device_init}
- {id: sleeptimer}
- {id: nvm3_default}

other_file:
- path: readme.md

toolchain_settings: []

ui_hints:
  highlight:
  - {path: readme.md, focus: true}

template_contribution: []
