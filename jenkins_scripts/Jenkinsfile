pipeline {
    agent none
    environment {
        TCM_NEXUS_SERVER = "nexus.silabs.com"
        RS9116_FIRMWARE = "RS9116W.2.4.1.8"
        SQA_TEST_AGENT = "sqa_test_agent-2021-09-21-16"
        SSH_TARGET = "10.207.8.23"
        HARNESS_NAME = "harness_example"
        UTF_PYTEST_COMMAND = "pytest --params=params.yaml --tb=native test_package/test_cases/test_wifi.py"
        FLASH_RS9116 = false
        FLASH_EFR32 = false
        BRANCH = "UTF-245-release_milestone8"
    }
    stages {
        stage('Start') {
            agent {
                label 'swarm && linux64'
            }
            stages{
                stage('Toolchain Setup'){
                    steps {
                        withCredentials([sshUserPrivateKey(credentialsId: 'personal_username_ssh', \
                                                           keyFileVariable: 'TCM_JENKINS_SSH_KEY_PATH', \
                                                           passphraseVariable: 'SSH_KEY_PATH_PASSPHRASE', \
                                                           usernameVariable: 'SSH_KEY_USERNAME')]) {
                            sh '''
                                export GIT_SSH=ssh
                                export GIT_SSH_COMMAND="ssh -i ${TCM_JENKINS_SSH_KEY_PATH} -o StrictHostKeyChecking=no"
                                git submodule update --init --recursive utf_pytest
                            '''
                        }
                        script {
                            if(isUnix()) {
                                sh '''
                                    pip install virtualenv
                                    if [ ! -d ./venv ]; then
                                      python3 -m venv venv
                                    fi
                                    . venv/bin/activate
                                    pushd utf_pytest
                                    pip install -r requirements.txt
                                '''
                            } else {
                                withCredentials([sshUserPrivateKey(credentialsId: 'personal_username_ssh', \
                                                           keyFileVariable: 'TCM_JENKINS_SSH_KEY_PATH', \
                                                           passphraseVariable: 'SSH_KEY_PATH_PASSPHRASE', \
                                                           usernameVariable: 'SSH_KEY_USERNAME')]) {
                                    sh '''
                                        export GIT_SSH=ssh
                                        export GIT_SSH_COMMAND="ssh -i ${TCM_JENKINS_SSH_KEY_PATH} -o StrictHostKeyChecking=no"
                                        git submodule update --init --recursive tcmgr
                                    '''
                                }
                                bat '''
                                    call tcm_setup.bat
                                    pip install virtualenv
                                    if not EXIST venv (
                                        python -m venv venv
                                    )
                                    copy /y venv\\scripts\\python.exe  venv\\scripts\\python3.exe
                                    call venv\\scripts\\activate
                                    pushd utf_pytest
                                    pip install -r requirements.txt
                                '''
                            }
                        }
                    }
                }
                stage('Get rs9116 binary') {
                    steps{
                        script{
                            if(FLASH_RS9116.toBoolean()){
                                dir('rs9116_binary'){
                                    checkout changelog: false,
                                            poll: false,
                                            scm: [$class: 'GitSCM',
                                                    branches: [[name: '*/RS9116W.2.4.1.8']],
                                                    extensions: [[$class: 'CloneOption', depth: 1, noTags: true, shallow: true]],
                                                    userRemoteConfigs: [[credentialsId: 'personal_username_ssh',
                                                    url: 'ssh://git@stash.silabs.com/redpine/release_packages.git',
                                                    refspec: '+refs/heads/RS9116W.2.4.1.8:refs/remotes/origin/RS9116W.2.4.1.8']]]
                                    sh  '''
                                        unzip -o RS9116W.2.4.1.8.zip "RS9116W.2.4.1.8/firmware/RS9116W.2.4.1.8.rps"
                                        rm -f ../example_test_package/rs9116*.rps
                                        cp -f RS9116W.2.4.1.8/firmware/RS9116W.2.4.1.8.rps ../example_test_package/RS9116W.2.4.1.8.rps
                                    '''
                                }
                            } else {
                                echo "Skipping release package checkout for RS9116 firmware."
                            }
                        }
                    }
                }
                stage('Get sqa test agent binary') {
                    steps{
                        script{
                            if(FLASH_EFR32.toBoolean()){
                                dir('sqa_binary'){
                                    checkout changelog: false,
                                            poll: false,
                                            scm: [$class: 'GitSCM',
                                                    branches: [[name: '*/sqa_test_agent-2021-09-21-16']],
                                                    extensions: [[$class: 'CloneOption', depth: 1, noTags: true, shallow: true]],
                                                    userRemoteConfigs: [[credentialsId: 'personal_username_ssh',
                                                    url: 'ssh://git@stash.silabs.com/redpine/release_packages.git',
                                                    refspec: '+refs/heads/sqa_test_agent-2021-09-21-16:refs/remotes/origin/sqa_test_agent-2021-09-21-16']]]
                                    sh '''
                                       rm -f ../example_test_package/sqa_test_agent*.hex
                                       cp -f ./sqa_test_agent.hex ../example_test_package/sqa_test_agent-2021-09-21-16.hex
                                    '''
                                }
                            } else {
                                echo "Skipping release package checkout for SQA test agent."
                            }
                        }
                    }
                }
                stage('Update manifest yaml'){
                    steps {
                        sh '''
                            if [ -d venv/bin ]; then
                               . venv/bin/activate
                            else
                               . venv/Scripts/activate
                            fi
                            python3 jenkins_scripts/update_manifest.py RS9116W.2.4.1.8.rps sqa_test_agent-2021-09-21-16.hex false true ${FLASH_RS9116} ${FLASH_EFR32}
                        '''
                    }
                }
                stage('Run Tests') {
                    steps {
                        sh '''
                            rm -rf utf_pytest/test_package
                            cp -rf example_test_package/ utf_pytest/test_package
                        '''
                        dir('utf_pytest'){
                            sh '''
                                rm -rf reports
                                if [ -d venv/bin ]; then
                                   . ../venv/bin/activate
                                else
                                   . ../venv/Scripts/activate
                                fi
                                ./load_tests_docker.sh 10.207.8.23 harness_example
                            '''
//                             sh '''
//                                 rm -rf reports
//                                 ./load_tests_docker.sh ${SSH_TARGET} ${HARNESS_NAME}
//                             '''
                            archiveArtifacts 'test_package/**'
                            archiveArtifacts 'reports/**'
                            archiveArtifacts 'utf/harness/harness_example.yaml'
                            junit allowEmptyResults: false, testResults: 'reports/junit_report.xml'
                        }
                    }
                }
            }
        }
    }
}