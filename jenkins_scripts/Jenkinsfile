pipeline {
    agent none
    stages {
        stage('Start') {
            agent {
                label 'swarm && linux64'
            }
            stages{
                stage('Toolchain Setup'){
                    steps {
                        script {
                            if (env.SQA_TEST_AGENT == "") {
                                env.SQA_TEST_AGENT = env.RS9116_FIRMWARE
                            }
                        }
                        withCredentials([sshUserPrivateKey(credentialsId: 'mwlabuser-ssh-username-key', \
                                                           keyFileVariable: 'JENKINS_SSH_KEY_PATH', \
                                                           passphraseVariable: 'SSH_KEY_PATH_PASSPHRASE', \
                                                           usernameVariable: 'SSH_KEY_USERNAME')]) {
                            sh '''
                                export GIT_SSH=ssh
                                export GIT_SSH_COMMAND="ssh -i ${JENKINS_SSH_KEY_PATH} -o StrictHostKeyChecking=no"

                                git config --file=.gitmodules submodule.utf_core.url ssh://git@stash.silabs.com/utf/utf_core
                                git submodule update --init --recursive utf_core

                                git config --file=.gitmodules submodule.utf_wiseconnect.url ssh://git@stash.silabs.com/utf/utf_wiseconnect
                                git submodule update --init --recursive utf_wiseconnect
                            '''
                        }
                        script {
                            if(isUnix()) {
                                sh '''
                                    ./workspace_setup.sh
                                '''
                            } else {
                                bat '''
                                   call workspace_setup.bat
                                '''
                            }
                        }
                    }
                }
                stage('Get rs9116 binary') {
                    steps{
                        script{
                            if(FLASH_RS9116.toBoolean()){
                                if(RS9116_FIRMWARE != "Internal"){
                                    withCredentials([sshUserPrivateKey(credentialsId: 'mwlabuser-ssh-username-key', \
                                                               keyFileVariable: 'JENKINS_SSH_KEY_PATH', \
                                                               passphraseVariable: 'SSH_KEY_PATH_PASSPHRASE', \
                                                               usernameVariable: 'SSH_KEY_USERNAME')]) {
                                        
                                        if(BUILD_LOCATION == "build_artifacts"){
                                            sh '''
                                                rm -rf rs9116_binary
                                                export GIT_SSH=ssh
                                                export GIT_SSH_COMMAND="ssh -i ${JENKINS_SSH_KEY_PATH} -o StrictHostKeyChecking=no"
                                                git clone ssh://git@stash.silabs.com/redpine/build_artifacts.git -b ${RS9116_FIRMWARE}/build --single-branch rs9116_binary
                                            '''
                                        } else {
                                            sh '''
                                                rm -rf rs9116_binary
                                                export GIT_SSH=ssh
                                                export GIT_SSH_COMMAND="ssh -i ${JENKINS_SSH_KEY_PATH} -o StrictHostKeyChecking=no"
                                                git clone ssh://git@stash.silabs.com/redpine/release_packages.git -b ${RS9116_FIRMWARE} --single-branch rs9116_binary
                                            '''
                                        }
                                    }
                                    dir('rs9116_binary'){
                                        if(BUILD_LOCATION == "build_artifacts"){
                                            sh  '''
                                                rm -f ../manifest/rs9116*.rps
                                                cp -f firmware/RS9116*.rps ../manifest/${RS9116_FIRMWARE}.rps
                                            '''
                                        }else {
                                            sh  '''
                                                unzip -o ${RS9116_FIRMWARE}.zip "${RS9116_FIRMWARE}/firmware/${RS9116_FIRMWARE}.rps"
                                                rm -f ../manifest/rs9116*.rps
                                                cp -f ${RS9116_FIRMWARE}/firmware/RS9116*.rps ../manifest/${RS9116_FIRMWARE}.rps
                                            '''                                            
                                        }
                                    }
                                }
                            } else {
                                echo "Skipping release package checkout for RS9116 firmware."
                            }
                        }
                    }
                }
                stage('Build sqa test agent binary') {
                    steps{
                        script{
                            if(FLASH_EFR32.toBoolean()){
                                if(SQA_TEST_AGENT != "Internal"){
                                    withCredentials([sshUserPrivateKey(credentialsId: 'mwlabuser-ssh-username-key', \
                                                               keyFileVariable: 'JENKINS_SSH_KEY_PATH', \
                                                               passphraseVariable: 'SSH_KEY_PATH_PASSPHRASE', \
                                                               usernameVariable: 'SSH_KEY_USERNAME')]) {
                                        sh '''
                                            export GIT_SSH=ssh
                                            export GIT_SSH_COMMAND="ssh -i ${JENKINS_SSH_KEY_PATH} -o StrictHostKeyChecking=no"

                                            git config --file=.gitmodules submodule.mini_gecko_sdk.url ssh://git@stash.silabs.com/Redpine/mini_gecko_sdk
                                            git submodule update --init --recursive test_agent/mini_gecko_sdk

                                            git clone --no-checkout --branch=utf/dev --depth 1 ssh://git@stash.silabs.com/Redpine/utf test_agent/rs911x
                                            cd test_agent/rs911x
                                            git checkout utf/dev
                                            cd ../..
                                            
                                            rm -f manifest/sqa_test_agent*.hex
                                            ./build_test_agent_docker.sh ${SQA_TEST_AGENT} ${JENKINS_SSH_KEY_PATH} ${BUILD_LOCATION}
                                            cp -f manifest/sqa_test_agent.hex manifest/${SQA_TEST_AGENT}.hex
                                        '''
                                    }
                                }
                            } else {
                                echo "Skipping release package checkout for SQA test agent."
                            }
                        }
                    }
                }
                stage('Update manifest yaml'){
                    steps {
                        sh '''
                            if [ -d venv/bin ]; then
                               . venv/bin/activate
                            else
                               . venv/Scripts/activate
                            fi
                            python3 jenkins_scripts/update_manifest.py ${RS9116_FIRMWARE}.rps ${SQA_TEST_AGENT}.hex ${FLASH_RS9116} ${FLASH_EFR32}
                        '''
                    }
                }
                stage('Run Tests') {
                    steps {
                        echo BUILD_URL
                        echo BUILD_NUMBER
                        echo GIT_BRANCH
                        echo RUN_TESTS_DISPLAY_URL
                        echo RS9116_FIRMWARE
                        withEnv(['BUILD_URL='+BUILD_URL, 'BUILD_NUMBER='+BUILD_NUMBER, 'GIT_BRANCH='+GIT_BRANCH, 'RUN_TESTS_DISPLAY_URL='+RUN_TESTS_DISPLAY_URL, 'INSTALLER_URL_SDK=https://stash.silabs.com/projects/REDPINE/repos/release_packages/browse?at=refs%2Fheads%2F'+RS9116_FIRMWARE]){
                              sh "echo \$BUILD_URL"
                              sh "echo \$BUILD_NUMBER"
                              sh "echo \$GIT_BRANCH"
                              sh "echo \$RUN_TESTS_DISPLAY_URL"
                              sh "echo \$INSTALLER_URL_SDK"
                        }
                        sh '''
                            rm -rf reports
                            export SKIP_PROCESSING_ARTIFACTS=1

                            if [ -d venv/bin ]; then
                               . venv/bin/activate
                            else
                               . venv/Scripts/activate
                            fi

                            export PYTHONPATH=/opt/jenkins/jenkins-worker/workspace/UTF_WiFi/utf_core/src
                            echo $PYTHONPATH
                            echo $UTF_PYTEST_COMMAND

                            python executor/launch_utf_tests.py \
                                --target ${SSH_TARGET} \
                                --harness ${HARNESS_NAME} \
                                --docker_flags "-e PYTEST_COMMAND=${UTF_PYTEST_COMMAND}, \
                                    -e BUILD_URL=${BUILD_URL}, \
                                    -e BUILD_NUMBER=${BUILD_NUMBER}, \
                                    -e RUN_TESTS_DISPLAY_URL=${RUN_TESTS_DISPLAY_URL}, \
                                    -e JOB_NAME=${JOB_NAME}, \
                                    -e INSTALLER_URL_SDK=https://stash.silabs.com/projects/REDPINE/repos/release_packages/browse?at=refs%2Fheads%2F${RS9116_FIRMWARE}, \
                                    -e STUDIO_MIRROR_LOCATION=http://bostonstudiomirror/studio/v4/WSQA/rel.2885/, \
                                    -e TEST_SUITE=OT_Smoke_brd4161a, \
                                    -e BRANCH_NAME=${RS9116_FIRMWARE}, \
                                    -e SSH_TARGET=${SSH_TARGET}" \
                        '''
                        archiveArtifacts 'example_test_package/**'
                        archiveArtifacts 'reports/**'
                        archiveArtifacts "config/harnesses/${env.HARNESS_NAME}.yaml"
                        junit allowEmptyResults: false, testResults: 'reports/junit_report.xml'
                    }
                }
            }
        }
    }
}
