pipeline {
    agent none
    stages {
        stage('Start') {
            agent {
                label 'swarm && linux64'
            }
            stages{
                stage('Toolchain Setup'){
                    steps {
                        script {
                            if (env.SQA_TEST_AGENT == "") {
                                env.SQA_TEST_AGENT = env.RS9116_FIRMWARE
                            }
                        }
                        withCredentials([sshUserPrivateKey(credentialsId: 'mwlabuser-ssh-username-key', \
                                                           keyFileVariable: 'TCM_JENKINS_SSH_KEY_PATH', \
                                                           passphraseVariable: 'SSH_KEY_PATH_PASSPHRASE', \
                                                           usernameVariable: 'SSH_KEY_USERNAME')]) {
                            sh '''
                                export GIT_SSH=ssh
                                export GIT_SSH_COMMAND="ssh -i ${TCM_JENKINS_SSH_KEY_PATH} -o StrictHostKeyChecking=no"
                                git config --file=.gitmodules submodule.utf_pytest.url ssh://git@stash.silabs.com/iot_infra_sw/utf_python_core
                                git submodule update --init --recursive utf_pytest
                                

                            '''
                        }
                        script {
                            if(isUnix()) {
                                sh '''
                                    if [ ! -d ./venv ]; then
                                      python3 -m venv venv
                                    fi
                                    . venv/bin/activate
                                    cd ./utf_pytest
                                    #TODO: following echo and yaml installation to be removed after https://jira.silabs.com/browse/UTF-617 is addressed
                                    echo "Skipping installing until we have permanent fix for https://jira.silabs.com/browse/UTF-617"
                                    pip install pyyaml>=5.4
                                    pip install paramiko
                                    #pip install wheel
                                    #pip install -r requirements.txt
                                    cd ..
                                '''
                            } else {
                                withCredentials([sshUserPrivateKey(credentialsId: 'mwlabuser-ssh-username-key', \
                                                           keyFileVariable: 'TCM_JENKINS_SSH_KEY_PATH', \
                                                           passphraseVariable: 'SSH_KEY_PATH_PASSPHRASE', \
                                                           usernameVariable: 'SSH_KEY_USERNAME')]) {
                                    sh '''
                                        export GIT_SSH=ssh
                                        export GIT_SSH_COMMAND="ssh -i ${TCM_JENKINS_SSH_KEY_PATH} -o StrictHostKeyChecking=no"
                                        git submodule update --init --recursive tcmgr
                                    '''
                                }
                                bat '''
                                    call tcm_setup.bat
                                    if not EXIST venv (
                                        python -m venv venv
                                    )
                                    copy /y venv\\scripts\\python.exe  venv\\scripts\\python3.exe
                                    call venv\\scripts\\activate
                                    cd .\\utf_pytest
                                    pip install -r requirements.txt
                                    cd..
                                '''
                            }
                        }
                    }
                }
                stage('Get rs9116 binary') {
                    steps{
                        script{
                            if(FLASH_RS9116.toBoolean()){
                                if(RS9116_FIRMWARE != "Internal"){
                                    withCredentials([sshUserPrivateKey(credentialsId: 'mwlabuser-ssh-username-key', \
                                                               keyFileVariable: 'TCM_JENKINS_SSH_KEY_PATH', \
                                                               passphraseVariable: 'SSH_KEY_PATH_PASSPHRASE', \
                                                               usernameVariable: 'SSH_KEY_USERNAME')]) {
                                        
                                        if(BUILD_LOCATION == "build_artifacts"){
                                            sh '''
                                                rm -rf rs9116_binary
                                                export GIT_SSH=ssh
                                                export GIT_SSH_COMMAND="ssh -i ${TCM_JENKINS_SSH_KEY_PATH} -o StrictHostKeyChecking=no"
                                                git clone ssh://git@stash.silabs.com/redpine/build_artifacts.git -b ${RS9116_FIRMWARE}/build --single-branch rs9116_binary
                                            '''
                                        } else {
                                            sh '''
                                                rm -rf rs9116_binary
                                                export GIT_SSH=ssh
                                                export GIT_SSH_COMMAND="ssh -i ${TCM_JENKINS_SSH_KEY_PATH} -o StrictHostKeyChecking=no"
                                                git clone ssh://git@stash.silabs.com/redpine/release_packages.git -b ${RS9116_FIRMWARE} --single-branch rs9116_binary
                                            '''
                                        }
                                    }
                                    dir('rs9116_binary'){
                                        if(BUILD_LOCATION == "build_artifacts"){
                                            sh  '''
                                                rm -f ../example_test_package/rs9116*.rps
                                                cp -f firmware/RS9116*.rps ../example_test_package/${RS9116_FIRMWARE}.rps
                                            '''
                                        }else {
                                            sh  '''
                                                unzip -o ${RS9116_FIRMWARE}.zip "${RS9116_FIRMWARE}/firmware/${RS9116_FIRMWARE}.rps"
                                                rm -f ../example_test_package/rs9116*.rps
                                                cp -f ${RS9116_FIRMWARE}/firmware/RS9116*.rps ../example_test_package/${RS9116_FIRMWARE}.rps
                                            '''                                            
                                        }
                                    }
                                }
                            } else {
                                echo "Skipping release package checkout for RS9116 firmware."
                            }
                        }
                    }
                }
                stage('Build sqa test agent binary') {
                    steps{
                        script{
                            if(FLASH_EFR32.toBoolean()){
                                if(SQA_TEST_AGENT != "Internal"){
                                    withCredentials([sshUserPrivateKey(credentialsId: 'mwlabuser-ssh-username-key', \
                                                               keyFileVariable: 'TCM_JENKINS_SSH_KEY_PATH', \
                                                               passphraseVariable: 'SSH_KEY_PATH_PASSPHRASE', \
                                                               usernameVariable: 'SSH_KEY_USERNAME')]) {
                                        sh '''
                                            export GIT_SSH=ssh
                                            export GIT_SSH_COMMAND="ssh -i ${TCM_JENKINS_SSH_KEY_PATH} -o StrictHostKeyChecking=no"

                                            git config --file=.gitmodules submodule.mini_gecko_sdk.url ssh://git@stash.silabs.com/Redpine/mini_gecko_sdk
                                            git submodule update --init --recursive mini_gecko_sdk
                                            
                                            
                                            #git config --file=.gitmodules submodule.rs911x.url ssh://git@stash.silabs.com/Redpine/utf
                                            #git config --file=.gitmodules submodule.rs911x.shallow true
                                            #git submodule update --init --recursive rs911x
                                            
                                            git clone --no-checkout --branch=utf/dev --depth 1 ssh://git@stash.silabs.com/Redpine/utf rs911x
                                            cd rs911x
                                            git checkout utf/dev
                                            cd ..
                                            
                                            rm -f example_test_package/sqa_test_agent*.hex
                                            ./build_test_agent_docker.sh ${SQA_TEST_AGENT} ${TCM_JENKINS_SSH_KEY_PATH} ${BUILD_LOCATION}
                                            cp -f example_test_package/sqa_test_agent.hex example_test_package/${SQA_TEST_AGENT}.hex
                                        '''
                                    }
                                }
                            } else {
                                echo "Skipping release package checkout for SQA test agent."
                            }
                        }
                    }
                }
                stage('Update manifest yaml'){
                    steps {
                        sh '''
                            if [ -d venv/bin ]; then
                               . venv/bin/activate
                            else
                               . venv/Scripts/activate
                            fi
                            python3 jenkins_scripts/update_manifest.py ${RS9116_FIRMWARE}.rps ${SQA_TEST_AGENT}.hex ${FLASH_RS9116} ${FLASH_EFR32}
                        '''
                    }
                }
                stage('Run Tests') {
                    steps {
                        sh '''
                            rm -rf utf_pytest/test_package
                            cp -rf example_test_package/ utf_pytest/test_package
                        '''
                        dir('utf_pytest'){
                                echo BUILD_URL
                                echo BUILD_NUMBER
                                echo GIT_BRANCH
                                echo RUN_TESTS_DISPLAY_URL
                                echo RS9116_FIRMWARE
                                withEnv(['BUILD_URL='+BUILD_URL, 'BUILD_NUMBER='+BUILD_NUMBER, 'GIT_BRANCH='+GIT_BRANCH, 'RUN_TESTS_DISPLAY_URL='+RUN_TESTS_DISPLAY_URL, 'INSTALLER_URL_SDK=https://stash.silabs.com/projects/REDPINE/repos/release_packages/browse?at=refs%2Fheads%2F'+RS9116_FIRMWARE]){
                                      sh "echo \$BUILD_URL"
                                      sh "echo \$BUILD_NUMBER"
                                      sh "echo \$GIT_BRANCH"
                                      sh "echo \$RUN_TESTS_DISPLAY_URL"
                                      sh "echo \$INSTALLER_URL_SDK"
                                }
                            withCredentials([sshUserPrivateKey(credentialsId: 'mwlabuser-ssh-username-key', \
                                                           keyFileVariable: 'TCM_JENKINS_SSH_KEY_PATH', \
                                                           passphraseVariable: 'SSH_KEY_PATH_PASSPHRASE', \
                                                           usernameVariable: 'SSH_KEY_USERNAME')]) {
                                sh '''
                                    rm -rf reports
                                    export SKIP_PROCESSING_ARTIFACTS=1
                                    UTF_DOCKER_FLAGS="-e BUILD_URL=${BUILD_URL} -e BUILD_NUMBER=${BUILD_NUMBER} -e RUN_TESTS_DISPLAY_URL=${RUN_TESTS_DISPLAY_URL} -e JOB_NAME=${JOB_NAME} -e INSTALLER_URL_SDK=https://stash.silabs.com/projects/REDPINE/repos/release_packages/browse?at=refs%2Fheads%2F${RS9116_FIRMWARE} -e STUDIO_MIRROR_LOCATION=http://bostonstudiomirror/studio/v4/WSQA/rel.2885/ -e TEST_SUITE=OT_Smoke_brd4161a -e BRANCH_NAME=${RS9116_FIRMWARE} -e SSH_TARGET=${SSH_TARGET}"
                                    echo $UTF_DOCKER_FLAGS
                                    export UTF_DOCKER_FLAGS
                                    ./load_tests_docker.sh ${SSH_TARGET} ${HARNESS_NAME}
                                '''
                            }
                            archiveArtifacts 'test_package/**'
                            archiveArtifacts 'reports/**'
                            archiveArtifacts "utf/harness/${env.HARNESS_NAME}.yaml"
                            junit allowEmptyResults: false, testResults: 'reports/junit_report.xml'
                        }
                    }
                }
            }
        }
    }
}
