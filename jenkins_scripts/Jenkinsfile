pipeline {
    agent none
    environment {
        TCM_NEXUS_SERVER = "nexus.silabs.com"
    }
    stages {
        stage('Run') {
            agent {
                label 'ramakathare_jenkins_nodes'
            }
            stages{
                stage('Get rs9116 binary') {
                    steps{
                        dir('rs9116_binary'){
                            checkout changelog: false,
                                    poll: false,
                                    scm: [$class: 'GitSCM',
                                            branches: [[name: '*/${RS9116_RELEASE_PACKAGE_BRANCH}']],
                                            extensions: [[$class: 'CloneOption', depth: 1, noTags: true, shallow: true]],
                                            userRemoteConfigs: [[credentialsId: '87616d18-3af5-4fa6-b20f-538f92b10079',
                                            url: 'ssh://git@stash.silabs.com/redpine/release_packages.git',
                                            refspec: '+refs/heads/${RS9116_RELEASE_PACKAGE_BRANCH}:refs/remotes/origin/${RS9116_RELEASE_PACKAGE_BRANCH}']]]
                            sh  '''
                                unzip ${RS9116_RELEASE_PACKAGE_BRANCH}.zip "${RS9116_RELEASE_PACKAGE_BRANCH}/firmware/${RS9116_RELEASE_PACKAGE_BRANCH}.rps"
                                cp ${RS9116_RELEASE_PACKAGE_BRANCH}/firmware/${RS9116_RELEASE_PACKAGE_BRANCH}.rps ../example_test_package
                            '''
                        }
                    }
                }
                stage('Get sqa test agent binary') {
                    steps{
                        dir('sqa_binary'){
                            checkout changelog: false,
                                    poll: false,
                                    scm: [$class: 'GitSCM',
                                            branches: [[name: '*/${SQA_TEST_AGENT_BRANCH}']],
                                            extensions: [[$class: 'CloneOption', depth: 1, noTags: true, shallow: true]],
                                            userRemoteConfigs: [[credentialsId: '87616d18-3af5-4fa6-b20f-538f92b10079',
                                            url: 'ssh://git@stash.silabs.com/redpine/release_packages.git',
                                            refspec: '+refs/heads/${SQA_TEST_AGENT_BRANCH}:refs/remotes/origin/${SQA_TEST_AGENT_BRANCH}']]]
                            sh '''
                               cp sqa_test_agent.hex ../example_test_package/
                            '''
                        }
                    }
                }
                stage('Update manifest yaml'){
                    steps {
                        sh '''
                            git submodule update --init --recursive utf_pytest
                            #alias python=python3
                            python3 ./jenkins_scripts/update_manifest.py ${RS9116_RELEASE_PACKAGE_BRANCH}.rps ${SQA_TEST_AGENT_BRANCH}.hex
                        '''
                    }
                }
                stage('Run Tests') {
                    steps {
                        sh '''
                            rm -rf ./utf_pytest/test_package
                            cp -r example_test_package/ ./utf_pytest/test_package
                        '''
                    }
                    steps{
                        dir('utf_pytest'){
                            sh '''
                                ./load_tests_docker.sh ${SSH_TARGET} ${HARNESS_NAME}
                            '''
                            archiveArtifacts 'test_package/**'
                            archiveArtifacts 'reports/**'
                            archiveArtifacts 'utf/harness/${HARNESS_NAME}.yaml'
                            junit allowEmptyResults: false, testResults: 'reports/junit_report.xml'
                        }
                    }
                }
            }
        }
    }
}