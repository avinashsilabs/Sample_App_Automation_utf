function band(){																														
  var L=(E(60).checked?1:E(70).checked?2:3); 																														
  var i =0;																														
  i=1;																														
  if((m==6)&&(L==3))																														
  {																														
    alert('Dual Band not supportde in A.P Mode');																														
    E(60).checked=true;																														
    L=1; 																														
  }																														
  E('c0').disabled = false;																														
  if(E(536).checked == true)																														
  {																														
   E('c0').disabled = true;																														
  }																														
																														
  for(i;i<=11; i++)																														
  {																														
    E('c'+i).disabled = false;																														
  }																														
  i=36;																														
  for(i;i<=165; (i=i+2))																														
  {																														
    (i==52)&&(i=149);																														
    E('c'+i).disabled = false;																														
  }																														
  if(L==1)																														
  {																														
    i=36;																														
    for(i;i<=165; (i=i+2))																														
    {																														
      (i==52)&&(i=149);																														
      E('c'+i).disabled = true;																														
    }																														
  }																														
  else if(L==2)																														
  {																														
    i=1;																														
    for(i;i<=11; i++)																														
    {																														
      E('c'+i).disabled = true;																														
    }																														
  }																														
																														
  (L==1)&&((E(83).value)!=0)&&((E(83).value)>11)&&(E(83).value=1); 																														
  (L==2)&&((E(83).value)!=0)&&((E(83).value)<=11)&&(E(83).value=36); 																														
  ((m==6)&&(L==1)&&(E(83).value==0))&&(E(83).value=1); 																														
  ((m==6)&&(L==2)&&((E(83).value)==0))&&(E(83).value=36); 																														
   																														
}																														
