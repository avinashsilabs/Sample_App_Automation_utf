<script type='text/javascript'>
    function userSubmit() {
      var file1 = E('read_file').files[0];
      UpgradeRequest(file1);
    }
var file_ArrayBuffer;
var file_Int16Array;
var file_Int32Array;
var fileSize;
var chunkSize;
var start;
var offset;
var sequenceNo;
var retransmit;
var length;
var firmwareType;
var wlanFirmware = -1878159347;
var packetTimeout;
var upgradeTimeout;
var requestTimeout;
var countTimeout = 0;
var countUpgradationRequest = 0;
var countResend=0;
var flagRequest = 0;
var flagTimeout = 0;
var flagResend =0;
function UpgradeRequest(hexPacket){
  var blob_reader = new FileReader();
  blob_reader.onloadend = function(){
    fileSize = hexPacket.size -32 ;
    length = fileSize;
    chunkSize = 4096;
    start = 0;
    offset = 32;
    sequenceNo = 1;
    retransmit = 0;
    function ParseFile(file_ArrayBuffer,fileSize, sequenceNo, retransmit,firmwareType){
      var totalPacket;
      totalPacket = Math.ceil(fileSize/chunkSize);
      var blob = PacketCreation(file_Int16Array,sequenceNo,retransmit,totalPacket,fileSize,firmwareType);
      function resendPacket(){
        flagTimeout =1;
        if(countTimeout === 5){
          alert('Module not Responding');
          countTimeout = 0;
          return;
        }
        retransmit = 1;
        countTimeout++;
        ParseFile(file_ArrayBuffer,fileSize, sequenceNo, retransmit,firmwareType);
      }
      if(start < length){
        xmlhttp_payload.open('POST','FWUPPL',true);
        xmlhttp_payload.responseType = 'arraybuffer';
        xmlhttp_payload.send(blob);
        if(totalPacket == sequenceNo)
        {
          packetTimeout = setTimeout(resendPacket,20000);
        }
        else
        {
          packetTimeout = setTimeout(resendPacket,8000);
        }
      }
    }
    file_ArrayBuffer = blob_reader.result;
    file_Int16Array = new Int16Array(file_ArrayBuffer);
    file_Int32Array = new Int32Array(file_ArrayBuffer);
    var checksum_local=0;
    for(var dword = 0 ; dword < fileSize/4; dword++){
      checksum_local ^= file_Int32Array[dword+8];
    }
    var checksum_file =  file_Int32Array[0];
    var firmwareType =  file_Int32Array[1];
    if(checksum_file === checksum_local)
    {
      var blob = hexPacket.slice(0,32);
      var xmlhttp_payload;
      if (window.XMLHttpRequest) {
        xmlhttp_payload=new XMLHttpRequest();
      }  else {
        xmlhttp_payload=new ActiveXObject('Microsoft.XMLHTTP');
      }
      xmlhttp_payload.onreadystatechange=function()
      {
        if (xmlhttp_payload.readyState==4 && xmlhttp_payload.status==200) {
          if (xmlhttp_payload.response){
          } else {
            return;
          }
          var uInt16ArrayPacket = new Uint16Array(xmlhttp_payload.response);
          if (uInt16ArrayPacket[1]){
          } else {
            return;
          }
          if(((uInt16ArrayPacket[1])== sequenceNo) &&(uInt16ArrayPacket[0] == 0)){
            console.log('received response for payload with uInt16ArrayPacket'+sequenceNo);
            if(flagResend == 1){
              countResend = 0;
              flagResend = 0;
            }
            clearTimeout(packetTimeout);
            if(flagTimeout == 1){
              countTimeout = 0;
              flagTimeout = 0;
            }
            start=start+chunkSize;
            sequenceNo+=1;
            if (start < length) {
              ParseFile(file_ArrayBuffer,fileSize, sequenceNo, retransmit,firmwareType);
            } else {
              alert('File Sent error');
              return;
            }
          }else if(((uInt16ArrayPacket[1])== sequenceNo) &&(uInt16ArrayPacket[0] == 3)){
            clearTimeout(packetTimeout);
            alert('Firmware Upgraded Successfully');
            return;
          }else if(((uInt16ArrayPacket[1]) < sequenceNo) &&(uInt16ArrayPacket[0] == 0)){
            return;
          }else if(((uInt16ArrayPacket[1])== sequenceNo) &&(uInt16ArrayPacket[0] == 4)){
            clearTimeout(packetTimeout);
            alert('Upgradation failed.. Refresh the page and try again..');
            return;
          } else {
            flagResend = 1;
            clearTimeout(packetTimeout);
            console.log('BAD rxpkts cleared Timeout'+sequenceNo+'countResend'+countResend);
            if(countResend === 3){
              countResend =0;
              return;
            }
            countResend++;
            retransmit = 1;
            ParseFile(file_ArrayBuffer,fileSize, sequenceNo, retransmit,firmwareType);
          }
        }
      }
      var xmlhttp_req;
      if (window.XMLHttpRequest) {
        xmlhttp_req=new XMLHttpRequest();
      }  else {
        xmlhttp_req=new ActiveXObject('Microsoft.XMLHTTP');
      }
      xmlhttp_req.onreadystatechange=function()
      {
        if (xmlhttp_req.readyState==4 && xmlhttp_req.status==200) {
          clearTimeout(requestTimeout);
          var uInt16Array = new Uint16Array(xmlhttp_req.response);
          if(((uInt16Array[0] )  == 0) && ((uInt16Array[1] )==0)){
            ParseFile(file_ArrayBuffer,fileSize, sequenceNo, retransmit,firmwareType);
          } else {
            alert('Module is not ready to upgrade!');
          }
        }
      }
      function resendUpgradeRequest(){
        alert ('Module not Responding Please reload and try again.');
      }
      xmlhttp_req.open('POST'"																													
"'FWPUREQ',true);"																														
      xmlhttp_req.responseType = 'arraybuffer';																														
      xmlhttp_req.send(blob);																														
"      requestTimeout = setTimeout(resendUpgradeRequest,30000);"																														
    } else {																														
      alert('Incorrect File. Please select the correct file');																														
      return;																														
    }																														
"    function PacketCreation(file_Int16Array,sequenceNo,retransmit,totalPacket,fileSize,firmwareType){"																														
      var ControlField=0;/*bit0 wlan/bt bit1 retransmission bit2 EoF*/																														
      var chunkLength =chunkSize;																														
																														
      if(sequenceNo === totalPacket ){																														
        ControlField = ControlField | 4;																														
        chunkLength = fileSize%chunkSize ;																														
      }																														
      if(firmwareType === wlanFirmware){																														
        ControlField = ControlField | 1;																														
      }																														
      if(retransmit === 1 ){																														
        ControlField = ControlField | 2;																														
      }																														
      var buffer = new ArrayBuffer(chunkLength + 8);																														
      var int16Buffer = new Int16Array(buffer);																														
      int16Buffer[0] = 0;																														
      int16Buffer[1] = sequenceNo;																														
      int16Buffer[2] = ControlField;																														
      int16Buffer[3] = chunkLength;																														
      int16Buffer[0] = int16Buffer[1] ^int16Buffer[2] ^int16Buffer[3];																														
      for(var word_count = 0; word_count < chunkLength / 2; word_count++) {																														
        int16Buffer[word_count + 4] = file_Int16Array[16 + ((sequenceNo - 1) * (chunkSize/2)) + word_count];																														
        int16Buffer[0] = int16Buffer[0] ^ int16Buffer[word_count + 4];																														
      }																														
      var blob_local = new Blob([int16Buffer]);																														
      return blob_local;																														
    }																														
  }																														
  blob_reader.readAsArrayBuffer(hexPacket);																														
}																														
</script>																														
