function sub(){																														
  if(E(81).value == '')																														
  {																														
    E('err').innerHTML ='Error : Empty SSID Field';																														
    return false;																														
  }																														
  if((E(62).checked==true))																														
  {																														
    if(((E(336).checked==true)|| (E(536).checked==true))&& (E(84).value==''))																														
    {																														
      E('err').innerHTML ='Error : Empty PSK Field';																														
      return false;																														
    }																														
    if((m!=6)&&(E(337).checked==true)&& (E(97).value==''))																														
    {																														
      E('err').innerHTML ='Error : Empty User Identity/Password Field';																														
      return false;																														
    }																														
  }																														
  if(m==6)																														
  {																														
    if(((E(92).value)=='')||((E(92).value < 100)||(E(92).value > 1000)))																														
    {																														
"      E('err').innerHTML ='Error : Invalid Beacon Interval Value,it should be 100-1000';"																														
      return false;																														
    }																														
    if(((E(93).value)=='')||((E(93).value < 1)||(E(93).value > 255)))																														
    {																														
"      E('err').innerHTML ='Error : Invalid DTIM Interval,it should be 1-255';"																														
      return false;																														
    }																														
    if(((E(99).value)=='')||((E(99).value < 1)||(E(99).value > 9)))																														
    {																														
      E('err').innerHTML ='Error : Invalid Stations Count';																														
      return false;																														
    }																														
  }																														
																														
"  mp(N('Ih'), N('I')[0], '.');"																														
"  mp(N('Mh'), N('M')[0], '.');"																														
"  mp(N('Gh'), N('G')[0], '.');"																														
"  mp(N('i6'), N('I6')[0],':');"																														
"  mp(N('gw6'), N('G6')[0], ':');"																														
  if(m==6)																														
  {																														
    E(63).checked = false;																														
    E(71).checked = false;																														
    E(90).checked = false;																														
    E(102).checked = false;																														
  }																														
  if((m==0)&&(E(337).checked == true))																														
  {																														
    E(90).checked = false;																														
    E(102).checked = false;																														
  }																														
																														
  if(((m==0) || (m==6))&&(E(63).checked == false))																														
  {																														
    var ipa1 = N('I')[0].value; 																														
    var ipa2 = N('M')[0].value; 																														
    var ipa3 = N('G')[0].value; 																														
    var ipa4 = N('I6')[0].value; 																														
    var ipa5 = N('G6')[0].value;																														
    var m6 = N('M6')[0].value;																														
    if(((v==1)||(v==3))&&(E(63).checked==false)){																														
      if((ipa1=='0.0.0.0')||(ipa1=='...'))																														
      {																														
        E('err').innerHTML ='Error : Invalid IP Address';																														
        return false;																														
      }																														
      if((ipa2=='0.0.0.0')||(ipa2=='...'))																														
      {																														
        E('err').innerHTML ='Error : Subnet Mask Address';																														
        return false;																														
      }																														
      if((m==0) && ((ipa3=='0.0.0.0')||(ipa3=='...')))																														
      {																														
        E('err').innerHTML ='Error : Invalid Gateway Address';																														
        return false;																														
      }																														
    }																														
    if(((v==2)||(v==3))&&(E(71).checked==false)){																														
    if((ipa4=='0:0:0:0:0:0:0:0')||(ipa4==':::::::'))																														
    {																														
      E('err').innerHTML ='Error : Invalid IPV6 Address';																														
      return false;																														
    }																														
    if((m==0)&&((ipa5=='0:0:0:0:0:0:0:0')||(ipa5==':::::::')))																														
    {																														
      E('err').innerHTML ='Error : Invalid Router Address';																														
      return false;																														
    }																														
    if((m6=='0')||(m6==''))																														
    {																														
      E('err').innerHTML ='Error : Invalid IPV6 Prefix';																														
      return false;																														
    }																														
   }																														
																														
  }																														
																														
  if(E(68).value=='')																														
  {																														
    E('err').innerHTML ='Error : Empty Custom Feature bit map';																														
    return false;																														
  }																														
																														
  if(E(62).checked == false)																														
  {																														
    E(336).value = 0;																														
    E(337).value = 0;																														
    E(84).value =0;																														
    E(331).value =0;																														
    E(94).value =0;																														
    E(95).value =0;																														
    E(96).value =0;																														
    E(97).value =0;																														
  }																														
																														
}																														
																														
