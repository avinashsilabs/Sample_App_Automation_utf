.table {
	margin:0px;
	padding:0px;
	width:90%;
	border:1px solid #0062a8;
	margin-left: 0px;
	border-collapse: collapse;
}
.table tr:nth-child(odd){ background-color:#d0dfea; }
.table tr:nth-child(even)    { background-color:#ffffff; }

.table td{
	vertical-align:middle;
	border:1px solid #0062a8;
	border-width:0px 1px 1px 0px;
	text-align:center;
	padding:5px;
	font-size:14px;
	font-family:Helvetica;
	font-weight:normal;
	color:#000000;
}.table tr:last-child td{
	border-width:0px 1px 0px 0px;
}.table tr td:last-child{
	border-width:0px 0px 1px 0px;
}.table tr:last-child td:last-child{
	border-width:0px 0px 0px 0px;
}
.table tr:first-child td{
		background:-o-linear-gradient(bottom, #0062a8 5%, #0062a8 100%);	background:-webkit-gradient( linear, left top, left bottom, color-stop(0.05, #0062a8), color-stop(1, #0062a8) );
	background:-moz-linear-gradient( center top, #0062a8 5%, #0062a8 100% );
	filter:progid:DXImageTransform.Microsoft.gradient(startColorstr='#0062a8', endColorstr='#0062a8');	background: -o-linear-gradient(top,#0062a8,0062a8);


	background-color:#0062a8;
	border:0px solid #0062a8;
	text-align:center;
	border-width:0px 0px 1px 1px;
