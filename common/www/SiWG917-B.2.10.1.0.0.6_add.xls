	border-width: 1px;
	border-color: #0062A8;
	border-collapse: collapse;
	width: 90%;
}
.dtable th {
	font-size:12px;
	background-color:#0062A8;
	border-width: 1px;
	padding: 8px;
	border-style: solid;
	border-color: #0062A8;
	text-align:left;
}
.dtable tr {
