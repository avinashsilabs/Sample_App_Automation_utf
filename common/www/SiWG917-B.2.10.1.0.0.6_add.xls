body  {
	font: 100% Verdana;
	background: #666666;
	margin: 0; 	padding: 0;
	text-align: center;	color: #666666;
	background-color: #999999;
	height: 100%;
}
.twoColHybRtHdr #container {
	width: 90%;  
	background: #dee1e3;
	margin: 0 auto; 
	box-shadow: 0px 0px 10px 1px rgba(73, 130, 221, 0.75);
	text-align: left; 
	padding: 0px;
} 
b {
	display:inline-block;
	width:180px;
	text-align:right;
	text-transform:uppercase;
	font-size:14px;}

.twoColHybRtHdr #header {
	padding: 0 10px;  
	background-color: #0062a8;
} 
.twoColHybRtHdr #header h1 {
	margin: 0; 
	padding: 10px 0; 
}
.twoColHybRtHdr #header2 {
	padding: 0 10px;  
	background-color: #C9E71A;
}
.twoColHybRtHdr #header2 h2 {
	margin: 0;
	padding: 10px 0; 
	color: #666666;
}


.twoColHybRtHdr #footer {
	padding: 0 10px; 
	background:#0081D6;
	color: #FFFFFF;
} 
.twoColHybRtHdr #footer p {
	margin: 0; 
	padding: 10px 0; 
}


.fltrt { 
	float: right;
	margin-left: 8px;
}
.fltlft { 
	float: left;
	margin-right: 8px;
}
.clearfloat { 
	clear:both;
    height:0;
    font-size: 1px;
    line-height: 0px;
}
input,select,.btn {
	background:#fff;
	border:1px solid #bbb;
	border-radius:5px;
	height:26px;
	padding:0 4px;
	margin:0px 0px 5px 0px;
	width:240px;
} 
input:hover,input:focus {
border:1px solid #666;
box-shadow:0 0 3px #409ef5;} 
input[type='radio'],input[type='checkbox'] {
width:20px;height:14px;
margin-right:4px;} 
#hid {
visibility:hidden;
margin-right:14px;} 
.btn{ width:auto;
}
h1,.btn {
background:linear-gradient(#0081d6, #0062a8);color:#fff;} 
.btn:focus,.btn:hover {
border:1px solid #000;
box-shadow:none;} 
form {
	border-top:0px solid #700;
} h1,form {padding:0px 0;} h1,body {margin:0;}
input.no{width:45px;margin:12px 4px 0 0;}
div.menu3
{
	
    text-align:center;
	font-size:0;
	height: 25px;
    *position:relative;*top:1px;    
	background-color: #C9E71A;
}

div.menu3 a
{
    display: inline-block;
    padding: 0 30px;
    margin-right:1px; 
    background:#F7F7F7;
    color:Black;
    text-decoration:none;
    font: normal 12px Arial;
    line-height: 24px;
    border:2px solid #CAD0DB;
    border-bottom:0;
    color:#666;
    vertical-align:top;
    text-decoration:none;
}

div.menu3 a:hover
{
    background:#E9ECF0;
    line-height: 25px;
    color:#000;
}
div.menu3 a.active{
    background:#E9ECF0;
    line-height: 25px;
    color:#000;
}
a.active{
    background:#E9ECF0;
    line-height: 25px;
    color:#000;
}
div.menu3sub
{
	height:3px;
	border:1px solid #CAD0DB;
	background:#E9ECF0;
}

.rtable {
	font-size:12px;
	color:#666666;
	width:90%;
	border-width: 1px;
	border-color: #0062A8;
	border-collapse: collapse;
}
.rtable th {
	font-size:12px;
	background-color:#0062A8;
	border-width: 1px;
	padding: 5px;
	border-style: solid;
	border-color: #0062A8;
	text-align:left;
}
.rtable tr {
	background-color:#D0DFEA;
}
.rtable td {
	font-size:12px;
	border-width: 1px;
	padding: 8px;
	border-style: solid;
	border-color: #5BBAFF;
}
.rtable td b {
	display:inline-block;
	width:435px;
	text-align:left;
	text-transform:uppercase;
	font-size:14px;}


