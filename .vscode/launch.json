{
    // Use IntelliSense to learn about possible attributes.
    // Hover to view descriptions of existing attributes.
    // For more information, visit: https://go.microsoft.com/fwlink/?linkid=830387
    "version": "0.2.0",
    "configurations": [
        {
            "name": "Python: Remote Attach",
            "type": "python",
            "request": "attach",
            "connect": {
                "host": "<replace with raspi IP>",
                "port": 5678
            },
            "pathMappings": [
                {
                    "localRoot": "${workspaceFolder}",
                    "remoteRoot": "."
                }
            ],
            "justMyCode": true
        },
        {
            "name": "Pytest",
            "type": "python",
            "request": "launch",
            "module": "pytest",
            "args": [
                "integration_test",
                "--tb",
                "native",
                "--skip_parametrization",
                "-v",
                "--manifest",
                "manifest/blank_manifest.yaml",
                "--tmconfig",
                "integration_test/.sequence_manager/test_execution_definitions/.test_sequence.yaml"
            ],
            "cwd": "${workspaceFolder}",
            "console": "integratedTerminal",
            "env": {
                "PYTHONPATH": "${workspaceFolder}:${workspaceFolder}/utf_core/src:${workspaceFolder}/utf_wiseconnect"
            }
        }
    ]
}